# StockPassport environment
# Never commit real secrets or private RPC credentials.

# Browser / Vercel build variables
VITE_REOWN_PROJECT_ID=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_NETWORK=devnet

# Leave blank for production: the frontend calls same-origin Vercel /api Functions.
VITE_API_BASE_URL=

# Synthetic Devnet assets. These are demo securities, not real equities.
VITE_DEVNET_CASH_MINT=
VITE_DEVNET_NVDA_MINT=
VITE_DEVNET_AAPL_MINT=
VITE_DEVNET_MSFT_MINT=
VITE_DEVNET_GOOG_MINT=

# Optional browser-safe Supabase configuration.
# Never put a Supabase service-role key in Vite/browser variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel Function / server-only variables
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_API_KEY=
QUOTE_SIGNING_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Devnet market/faucet wallet. Public address only; private key stays server-side.
DEVNET_MARKET_WALLET=4JuZbuYNvoC2sZLGGdeP9fSyq5NqRBRaK8eLCb2uiRBf
DEVNET_MARKET_PRIVATE_KEY=
DEVNET_MARKET_KEYPAIR_JSON=

# Server-side synthetic asset mints used by quotes, faucet and settlement.
DEVNET_CASH_MINT=
DEVNET_NVDA_MINT=
DEVNET_AAPL_MINT=
DEVNET_MSFT_MINT=
DEVNET_GOOG_MINT=
