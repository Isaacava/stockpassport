# StockPassport development environment
# Never commit real secrets or private RPC credentials.

VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_NETWORK=devnet

# API service. Leave blank when frontend/API are same-origin.
# Production Vercel frontend should point this at the dedicated Render service.
VITE_API_BASE_URL=https://stockpassport-market.onrender.com

# Synthetic Devnet assets. These are demo securities, not real equities.
VITE_DEVNET_CASH_MINT=
VITE_DEVNET_NVDA_MINT=
VITE_DEVNET_AAPL_MINT=
VITE_DEVNET_MSFT_MINT=
VITE_DEVNET_GOOG_MINT=

# Optional Supabase browser client configuration.
# Only publish the project's URL and publishable/anon key here.
# Never put a Supabase service-role key in Vite/browser variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Render/server-only Mainnet price reference configuration.
# Price API V3 is queried for verified Solana xStock Mainnet mints.
# Keep JUPITER_API_KEY server-side only. Keyless requests are supported for prototypes.
MAINNET_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_API_KEY=
